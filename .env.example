# =========================================================
# Telegram
# =========================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# =========================================================
# Режим работы
# =========================================================
# DRY_RUN=true  -> ничего не публикуем, только выводим в консоль
DRY_RUN=true

# Сколько постов отправлять за один запуск --once
POSTS_PER_RUN=3
# Пауза между публикациями в рамках одного --once (секунды)
POST_INTERVAL_SECONDS=60

# Сколько постов публиковать в день в режиме SCHEDULE_MODE=random_daily
POSTS_PER_DAY=15
# Окно времени, в которое случайно распределяются эти посты (формат HH:MM)
POST_WINDOW_START=10:00
POST_WINDOW_END=20:00

# =========================================================
# Фильтрация
# =========================================================
CITY=Минск
RENT_TYPE=long_term
ALLOWED_LISTING_TYPES=apartment,room
REQUIRE_PHOTO=true

MIN_ROOM_PRICE_USD=80
MIN_APARTMENT_PRICE_USD=150
MAX_PRICE_USD=2000

# =========================================================
# Источники (быстрое включение/отключение)
# =========================================================
ENABLE_REALT=true
ENABLE_KUFAR=true
ENABLE_DOMOVITA=true
ENABLE_HATA=true
ENABLE_ONLINER=false

# =========================================================
# HTTP-клиент
# =========================================================
REQUEST_TIMEOUT=15
REQUEST_DELAY_SECONDS=3
REQUEST_MAX_RETRIES=3
USER_AGENT=Mozilla/5.0 RentAggregatorBot/1.0

# =========================================================
# Планировщик
# =========================================================
# SCHEDULE_MODE: once | interval | daily | random_daily
SCHEDULE_MODE=random_daily
RUN_EVERY_HOURS=6
POST_TIME=10:00
TIMEZONE=Europe/Minsk

# =========================================================
# Логирование
# =========================================================
LOG_LEVEL=INFO
LOG_FILE=rent_bot.log

# =========================================================
# Storage
# =========================================================
DB_PATH=published.sqlite3
